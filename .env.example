# Izzy + Oh Stuffing — copy to .env.local and fill in real values.
# Never commit real secrets.

# Auth (Oh Stuffing session cookies)
AUTH_SECRET=dev-secret-change-me

# Anthropic (policy decode + Ask Izzy)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (Postgres, Auth, Storage for policy docs)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Configured in Stripe at $6.99/mo
STRIPE_PRICE_ID_MONTHLY=price_xxxxxx
# Configured in Stripe at $39.99/yr
STRIPE_PRICE_ID_ANNUAL=price_yyyyyy

# Optional legacy aliases (used only if STRIPE_PRICE_ID_* are unset)
# STRIPE_PRICE_WEEKLY=price_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...

# Upstash Redis (Oh Stuffing account storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3847
# IZZY_PRO_UNLOCK=true
